        string Title,
        string Message,
        string ConfirmLabel,
        Func<Task> Action,
        bool Danger = true);

    private sealed record MoveRequest(
        string Title,
        string Eyebrow,
        string Subtitle,
        bool AllowUnassigned,
        string UnassignedLabel,
        string UnassignedNote,
        Guid? CurrentId,
        IReadOnlyList<MoveOption> Options,
        Func<Guid?, Task> Apply);
}
