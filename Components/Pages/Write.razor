    // ----- AI muse -----------------------------------------------------------

    private async Task RunAiAsync(AiRunRequest run)
    {
        if (_aiBusy)
        {
            return;
        }

        if (_location is not { } location)
        {
            Toasts.Show("Select a beat first.", ToastKind.Warning);
            return;
        }

        if (run.Action == AiAction.Freeform && string.IsNullOrWhiteSpace(run.Instruction))
        {
            return;
        }

        string? selection = null;
        if (run.Action is AiAction.TightenProse or AiAction.Freeform)
        {
            selection = await GetSelectionAsync();
        }

        if (run.Action == AiAction.TightenProse &&
            string.IsNullOrWhiteSpace(selection) &&
            string.IsNullOrWhiteSpace(location.Beat.Content))
        {
            Toasts.Show("Select a passage or write something first.", ToastKind.Warning);
            return;
        }

        _aiOpen = true;
        _focusMode = false;
        if (_narrow)
        {
            _outlineOpen = false;
        }
        _aiTargetBeatId = location.Beat.Id;
        _aiSelection = selection;
        _aiAction = run.Action;
        _aiText = "";
        _aiError = null;
        _aiBusy = true;

        var cts = new CancellationTokenSource();
        _aiCts = cts;
        StateHasChanged();

        var request = AiPrompts.Build(run.Action, location, _book, selection, run.Instruction);
        var buffer = new StringBuilder();
        var lastFlush = DateTime.MinValue;

        try
        {
            await foreach (var chunk in Ai.StreamAsync(request, cts.Token))
            {
                buffer.Append(chunk);

                if ((DateTime.UtcNow - lastFlush).TotalMilliseconds >= 55)
                {
                    _aiText = buffer.ToString();
                    lastFlush = DateTime.UtcNow;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (buffer.Length > 0)
            {
                buffer.Append("\n\n[stopped]");
            }
        }
        catch (Exception ex)
        {
            _aiError = ex.Message;
        }
        finally
        {
            _aiText = buffer.ToString();
            _aiBusy = false;

            if (ReferenceEquals(_aiCts, cts))
            {
                _aiCts = null;
            }

            cts.Dispose();
            StateHasChanged();
        }
    }

    private void StopAi() => _aiCts?.Cancel();

    private async Task<string?> GetSelectionAsync()
    {
        if (_editor is null)
        {
            return null;
        }

        return await _editor.GetSelectionAsync();
    }

    private async Task AppendAiAsync() => await ApplyAiAsync(replace: false);

    private async Task ReplaceAiAsync() => await ApplyAiAsync(replace: true);

    private async Task ApplyAiAsync(bool replace)
    {
        if (_aiTargetBeatId is not { } beatId || string.IsNullOrWhiteSpace(_aiText))
        {
            return;
        }

        var location = Outline.Find(_book, beatId);
        if (location is null)
        {
            Toasts.Show("The beat this draft belongs to no longer exists.", ToastKind.Warning);
            return;
        }

        var beat = location.Value.Beat;
        var text = _aiText.Trim();

        _undoBeatId = beat.Id;
        _undoContent = beat.Content;

        if (replace)
        {
            if (!string.IsNullOrWhiteSpace(_aiSelection))
            {
                var index = beat.Content.IndexOf(_aiSelection, StringComparison.Ordinal);
                if (index < 0)
                {
                    Toasts.Show("The selected text changed while the muse was writing. Copy the result instead.", ToastKind.Warning);
                    _undoBeatId = null;
                    _undoContent = null;
                    return;
                }

                beat.Content = beat.Content[..index] + text + beat.Content[(index + _aiSelection.Length)..];
            }
            else
            {
                beat.Content = text;
            }
        }
        else
        {
            beat.Content = string.IsNullOrWhiteSpace(beat.Content)
                ? text
                : beat.Content.TrimEnd() + "\n\n" + text;
        }

        beat.UpdatedUtc = DateTime.UtcNow;
        if (beat.Status == BeatStatus.Outline)
        {
            beat.Status = BeatStatus.Draft;
        }

        Store.MarkDirty();
        await PersistAsync();
        SelectBeatById(beat.Id);
        StateHasChanged();
        Toasts.Show(replace ? "The AI revision replaced the text." : "AI text added to the beat.", ToastKind.Success);
    }

    private async Task UndoAiAsync()
    {
        if (_undoBeatId is not { } beatId || _undoContent is null)
        {
            return;
        }

        var location = Outline.Find(_book, beatId);
        if (location is null)
        {
            Toasts.Show("That beat no longer exists.", ToastKind.Warning);
            _undoBeatId = null;
            _undoContent = null;
            return;
        }

        location.Value.Beat.Content = _undoContent;
        location.Value.Beat.UpdatedUtc = DateTime.UtcNow;
        Store.MarkDirty();
        await PersistAsync();

        _undoBeatId = null;
        _undoContent = null;
        SelectBeatById(beatId);
        StateHasChanged();
        Toasts.Show("Reverted the last AI edit.", ToastKind.Success);
    }

    private async Task AddAiBeatsAsync()
    {
        var parsed = ParseBeatLines(_aiText);
        if (parsed.Count == 0)
        {
            Toasts.Show("That response didn't contain a bulleted list of beats.", ToastKind.Warning);
            return;
        }

        if (_aiTargetBeatId is not { } targetId || Outline.Find(_book, targetId) is not { } location)
        {
            Toasts.Show("The beat this was written for no longer exists.", ToastKind.Warning);
            return;
        }

        var container = location.Scene?.Beats ?? _book.Beats;
        var insertAt = Math.Clamp(location.BeatIndex + 1, 0, container.Count);

        Store.Edit(_ => container.InsertRange(insertAt, parsed));
        await PersistAsync();

        SelectBeatById(parsed[0].Id);
        _aiText = "";
        _aiError = null;
        _aiAction = null;
        StateHasChanged();
        Toasts.Show(
            location.Scene is { } scene
                ? $"Added {parsed.Count} beat(s) to “{scene.Title}”."
                : $"Added {parsed.Count} unassigned beat(s).",
            ToastKind.Success);
    }

    private static List<Beat> ParseBeatLines(string text)
    {
        var beats = new List<Beat>();

        foreach (var raw in text.Split('\n'))
        {
            if (!BulletPattern.IsMatch(raw))
            {
                continue;
            }

            var line = BulletPattern.Replace(raw, "").Trim();
            if (line.Length == 0)
            {
                continue;
            }

            var title = line;
            var brief = "";
            var separator = BeatSeparator.Match(line);
            if (separator.Success)
            {
                title = line[..separator.Index].Trim();
                brief = line[(separator.Index + separator.Length)..].Trim();
            }

            if (title.Length == 0)
            {
                continue;
            }

            if (title.Length > 110)
            {
                title = title[..107] + "…";
            }

            beats.Add(new Beat
            {
                Title = title,
                Brief = brief,
                Status = BeatStatus.Outline
            });
        }

        return beats;
    }

    private Chapter? FindChapter(Guid chapterId) =>
        _book.Chapters.FirstOrDefault(c => c.Id == chapterId);

    private Scene? FindScene(Guid sceneId) =>
        Outline.FindScene(_book, sceneId);

    private static string TitleOr(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    // ----- Keyboard shortcuts (invoked from scribe.js) -----------------------

    [JSInvokable]
    public async Task SaveNow()
    {
        await Store.FlushAsync();
        RefreshSaveState();

        if (Store.State == SaveState.Error)
        {
            Toasts.Show(Store.LastError ?? "Could not save the manuscript.", ToastKind.Error);
        }
        else if (Store.State == SaveState.Saved)
        {
            Toasts.Show("Saved.", ToastKind.Success);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void NavigateBeat(int delta)
    {
        if (_selectedBeatId is not { } id)
        {
            return;
        }

        if (Outline.Neighbour(_book, id, delta) is { } location)
        {
            SelectBeatById(location.Beat.Id, saveCurrent: true);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void ToggleFocus() => ToggleFocusMode();

    [JSInvokable]
    public void ToggleAiFromShortcut() => ToggleAi();

    [JSInvokable]
    public void EscapeShortcut()
    {
        if (_confirm is not null)
        {
            _confirm = null;
            StateHasChanged();
            return;
        }

        if (_entityDialog is not null)
        {
            _entityDialog = null;
            StateHasChanged();
            return;
        }

        if (_dialog != DialogKind.None)
        {
            _dialog = DialogKind.None;
            StateHasChanged();
            return;
        }

        if (_aiBusy)
        {
            StopAi();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        Store.SaveStateChanged -= HandleStoreEvent;
        Store.BookReplaced -= HandleBookReplaced;
        Store.BackupCreated -= HandleStoreEvent;
        AiSettings.Changed -= HandleAiSettingsChanged;

        _aiCts?.Cancel();
        _aiCts?.Dispose();
        _aiCts = null;

        if (_shortcutsRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("scribe.unregisterShortcuts");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        _self?.Dispose();
    }

    private enum DialogKind
    {
        None,
        Book,
        Ai,
        Backups,
        Shortcuts
    }

