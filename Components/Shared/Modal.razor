@inject IJSRuntime JS

<div class="modal-layer" @ref="_layer" tabindex="-1" @onclick="HandleBackdrop">
    <div class="modal @Class" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
        <header class="modal-head">
            <div>
                @if (!string.IsNullOrWhiteSpace(Eyebrow))
                {
                    <p class="eyebrow">@Eyebrow</p>
                }
                <h2>@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="modal-subtitle">@Subtitle</p>
                }
            </div>
            <button type="button" class="icon-btn" @onclick="() => OnClose.InvokeAsync()" aria-label="Close dialog">
                <Icon Name="close" />
            </button>
        </header>

        <div class="modal-body">
            @ChildContent
        </div>

        @if (Footer is not null)
        {
            <footer class="modal-foot">@Footer</footer>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _layer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("scribe.focusFirst", _layer);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private Task HandleBackdrop(MouseEventArgs args) => OnClose.InvokeAsync();
}
