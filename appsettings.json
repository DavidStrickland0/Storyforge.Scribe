{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": "App_Data",
    "AutosaveDebounceMs": 1200,
    "BackupIntervalMinutes": 15,
    "MaxBackups": 96
  },
  "Ai": {
    "Provider": "offline",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "Temperature": 0.85,
    "MaxTokens": 900,
    "ReasoningEffort": ""
  }
}
